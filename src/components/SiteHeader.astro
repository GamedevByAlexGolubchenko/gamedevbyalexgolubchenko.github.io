---
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.jpg';
import LanguageFlag from './LanguageFlag.astro';
import { locales, translations } from '../data/site';

interface Props {
	page: 'home' | 'support';
}

import { localeFromPath, pagePath } from '../data/routing';
const { page } = Astro.props;
const currentLocale = localeFromPath(Astro.url.pathname);
const dictionary = translations[currentLocale];
const selectedLanguage = locales.find(locale => locale.code === currentLocale)!;
---

<header class="site-header">
	<a class="wordmark" href={pagePath(currentLocale)} aria-label={dictionary.common.homeLinkLabel} data-i18n-aria="common.homeLinkLabel">
		<Image class="wordmark-mark" src={profileImage} alt="" width={76} widths={[40, 76, 114]} sizes="38px" format="webp" quality={85} />
		<span class="wordmark-name" data-i18n="common.name">{dictionary.common.name}</span>
	</a>

	<nav class="primary-nav" aria-label="Primary navigation">
		<a href={pagePath(currentLocale)} data-nav="home" class:list={{ active: page === 'home' }} aria-current={page === 'home' ? 'page' : undefined} data-i18n="nav.home">{dictionary.nav.home}</a>
		<a href={`${pagePath(currentLocale)}#work`} data-nav="work" data-i18n="nav.work">{dictionary.nav.work}</a>
		<a href={pagePath(currentLocale, 'support')} data-nav="support" class:list={{ active: page === 'support' }} aria-current={page === 'support' ? 'page' : undefined} data-i18n="nav.support">{dictionary.nav.support}</a>
	</nav>

	<details class="language-picker" data-language-picker>
		<summary class="language-toggle" data-language-toggle aria-label={`${dictionary.nav.language}: ${selectedLanguage.label}`}>
			<span class="language-current-flag" data-current-flag aria-hidden="true"><LanguageFlag flag={selectedLanguage.flag} /></span>
			<span data-current-language lang={currentLocale}>{selectedLanguage.label}</span>
			<svg class="language-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
		</summary>
		<div class="language-options">
			{locales.map(locale => <a href={pagePath(locale.code, page)} hreflang={locale.code} class="language-option" data-locale-option={locale.code} lang={locale.code} aria-current={locale.code === currentLocale ? 'true' : undefined}>
				<LanguageFlag flag={locale.flag} />
				<span data-language-name>{locale.label}</span><span class="language-check" aria-hidden="true">✓</span>
			</a>)}
		</div>
	</details>
</header>
