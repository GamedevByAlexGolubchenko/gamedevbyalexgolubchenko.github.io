---
import { profile } from '../data/site';

interface Props {
	page: 'home' | 'support';
}

const { page } = Astro.props;
---

<header class="site-header">
	<a class="wordmark" href="/" aria-label={`${profile.name} — home`}>
		<img class="wordmark-mark" src="/images/profile.jpg" alt="" width="640" height="640" />
		<span class="wordmark-name">{profile.name}</span>
	</a>

	<nav class="primary-nav" aria-label="Primary navigation">
		<a href="/" data-nav="home" class:list={{ active: page === 'home' }} aria-current={page === 'home' ? 'page' : undefined} data-i18n="nav.home">Home</a>
		<a href="/#work" data-nav="work" data-i18n="nav.work">Work</a>
		<a href="/support/" data-nav="support" class:list={{ active: page === 'support' }} aria-current={page === 'support' ? 'page' : undefined} data-i18n="nav.support">Support</a>
	</nav>

	<button class="language-toggle" type="button" data-language-toggle aria-label="Switch language">
		<span data-locale-option="en">EN</span>
		<span class="language-divider" aria-hidden="true">/</span>
		<span data-locale-option="ru">RU</span>
	</button>
</header>
