---
import { profile } from '../data/site';

interface Props {
	page: 'home' | 'support';
}

const { page } = Astro.props;
---

<header class="site-header">
	<a class="wordmark" href="/" aria-label={`${profile.name} — home`}>
		<span class="wordmark-mark" aria-hidden="true">AG</span>
		<span class="wordmark-name">{profile.name}</span>
	</a>

	<nav class="primary-nav" aria-label="Primary navigation">
		<a href="/" class:list={{ active: page === 'home' }} data-i18n="nav.home">Home</a>
		<a href="/#work" data-i18n="nav.work">Work</a>
		<a href="/support/" class:list={{ active: page === 'support' }} data-i18n="nav.support">Support</a>
	</nav>

	<button class="language-toggle" type="button" data-language-toggle aria-label="Switch language">
		<span data-locale-option="en">EN</span>
		<span class="language-divider" aria-hidden="true">/</span>
		<span data-locale-option="ru">RU</span>
	</button>
</header>
