---
import { translations, type Project } from '../data/site';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const copy = translations.en.home.projects[index];
const prefix = `home.projects.${index}`;
---
<section class="project-gallery" data-gallery aria-label={translations.en.gallery.label} data-i18n-aria="gallery.label">
 <div class="gallery-frame">
  <div class="gallery-slide gallery-cover" data-slide>
   <img src={project.cover} alt={copy.coverAlt} data-i18n-alt={`${prefix}.coverAlt`} width="1672" height="941" loading="lazy" />
  </div>
  {project.screenshots.map((shot) => <figure class="gallery-slide" data-slide hidden>
   <img src={shot.src} alt={copy[`${shot.key}Alt`]} data-i18n-alt={`${prefix}.${shot.key}Alt`} loading="lazy" />
  </figure>)}
 </div>
 <div class="gallery-caption-row">
 <div class="gallery-caption" aria-live="polite" aria-atomic="true">
  <span data-caption data-i18n="gallery.cover">{translations.en.gallery.cover}</span>
  {project.screenshots.map(shot => <span data-caption data-i18n={`${prefix}.${shot.key}`} hidden>{copy[shot.key]}</span>)}
 </div>
 <button class="gallery-open" type="button" data-open data-i18n-aria="gallery.open" aria-label="Expand image"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg></button>
 </div>
 {project.screenshots.length > 0 && <div class="gallery-controls" data-controls hidden>
  <button type="button" data-previous><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg><span data-i18n="gallery.previous">Previous</span></button>
  <output data-position>1 / {project.screenshots.length + 1}</output>
  <button type="button" data-next><span data-i18n="gallery.next">Next</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" /></svg></button>
 </div>}
 <dialog class="gallery-lightbox" data-lightbox data-i18n-aria="gallery.label" aria-label="Project gallery">
  <div class="lightbox-panel">
   <button class="lightbox-close" type="button" data-close data-i18n-aria="gallery.close" aria-label="Close gallery" autofocus>×</button>
   <div class="lightbox-stage"><img data-full-image alt="" draggable="false" /></div>
   <div class="lightbox-caption" data-full-caption aria-live="polite"></div>
   <div class="lightbox-controls">
    <button type="button" data-full-previous data-i18n-aria="gallery.previous" aria-label="Previous"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg></button>
    <output data-full-position aria-live="polite"></output>
    <button type="button" data-full-next data-i18n-aria="gallery.next" aria-label="Next"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" /></svg></button>
   </div>
  </div>
 </dialog>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(gallery => {
  const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
  const captions = [...gallery.querySelectorAll<HTMLElement>('[data-caption]')];
  const controls = gallery.querySelector<HTMLElement>('[data-controls]');
  const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const fullImage = gallery.querySelector<HTMLImageElement>('[data-full-image]')!;
  const opener = gallery.querySelector<HTMLButtonElement>('[data-open]')!;
  let current = 0;
  if (controls) controls.hidden = false;
  const syncFull = () => {
   const image = slides[current].querySelector('img')!;
   fullImage.src = image.src;
   fullImage.alt = image.alt;
   gallery.querySelector('[data-full-caption]')!.textContent = captions[current].textContent;
   gallery.querySelector('[data-full-position]')!.textContent = `${current + 1} / ${slides.length}`;
  };
  const move = (direction: number) => {
   current = (current + direction + slides.length) % slides.length;
   slides.forEach((slide, i) => { slide.hidden = i !== current; });
   captions.forEach((caption, i) => { caption.hidden = i !== current; });
   const position = gallery.querySelector('[data-position]');
   if (position) position.textContent = `${current + 1} / ${slides.length}`;
   if (dialog.open) syncFull();
  };
  opener.addEventListener('click', () => {
   syncFull();
   dialog.showModal();
   document.documentElement.classList.add('gallery-modal-open');
  });
  gallery.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
   document.documentElement.classList.remove('gallery-modal-open');
   opener.focus({ preventScroll: true });
  });
  gallery.querySelector('[data-full-previous]')!.addEventListener('click', () => move(-1));
  gallery.querySelector('[data-full-next]')!.addEventListener('click', () => move(1));
  gallery.querySelectorAll<HTMLButtonElement>('[data-full-previous], [data-full-next]').forEach(button => { button.hidden = slides.length < 2; });
  gallery.querySelector('[data-previous]')?.addEventListener('click', () => move(-1));
  gallery.querySelector('[data-next]')?.addEventListener('click', () => move(1));
  gallery.addEventListener('keydown', event => {
   if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
   event.preventDefault(); move(event.key === 'ArrowLeft' ? -1 : 1);
  });
 });
</script>
