---
import ProjectGallery from '../components/ProjectGallery.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, projects, translations, formatExperienceText } from '../data/site';

const en = translations.en;
---

<BaseLayout page="home" title={en.meta.homeTitle} description={en.meta.homeDescription}>
	<section class="hero">
		<div class="hero-main">
			<p class="eyebrow" data-i18n="home.eyebrow">{en.home.eyebrow}</p>
			<h1 data-i18n="home.title">{en.home.title}</h1>
			<p class="hero-intro" data-i18n="home.intro">{en.home.intro}</p>
			<div class="action-row">
				<a class="button-link" href="#work" data-i18n="home.primaryCta">{en.home.primaryCta}</a>
				<a class="button-link secondary" href="/support/" data-i18n="home.secondaryCta">{en.home.secondaryCta}</a>
			</div>
		</div>
		<aside class="hero-index" aria-label="Profile summary">
			<svg class="engineering-art" viewBox="0 0 320 900" preserveAspectRatio="xMidYMid slice" role="img" aria-labelledby="engineering-art-title">
                <title id="engineering-art-title">.NET, Unity, C#</title>
                <g class="art-wire">
                    <path d="M160 -1000V58L72 146V236L160 324V570L248 658V748L160 836V1900" />
                    <path d="M320 114H248L72 290V358L160 450L248 542V610L72 786H0" />
                </g>
                <g class="art-module">
                    <rect x="27" y="154" width="90" height="68" /><path d="M27 172H117" /><text x="37" y="167" class="art-number">01</text><text x="72" y="202" text-anchor="middle">.NET</text>
                    <rect x="115" y="416" width="90" height="68" /><path d="M115 434H205" /><text x="125" y="429" class="art-number">02</text><text x="160" y="464" text-anchor="middle">C#</text>
                    <rect x="203" y="678" width="90" height="68" /><path d="M203 696H293" /><text x="213" y="691" class="art-number">03</text><text x="248" y="726" text-anchor="middle">Unity</text>
                </g>
                <g class="art-terminal">
                    <circle cx="160" cy="58" r="5" /><circle cx="248" cy="114" r="4" /><circle cx="72" cy="290" r="5" />
                    <circle cx="248" cy="610" r="5" /><circle cx="72" cy="786" r="4" /><circle cx="160" cy="836" r="5" />
                </g>
            </svg>
		</aside>
	</section>


	<section class="content-section" aria-labelledby="about-title">
		<div class="section-heading">
			<p class="section-label" data-i18n="home.aboutLabel">{en.home.aboutLabel}</p>
			<div>
				<h2 class="section-title" id="about-title" data-i18n="home.aboutTitle">{en.home.aboutTitle}</h2>
				<p class="section-copy" data-i18n="home.aboutBody">{formatExperienceText(en.home.aboutBody, 'en')}</p>
			</div>
		</div>
		<div class="capability-groups">
			<section class="capability-group" aria-labelledby="technologies-title">
				<h3 id="technologies-title" class="capability-label" data-i18n="home.technologiesLabel">{en.home.technologiesLabel}</h3>
				<ul class="skills-list">{profile.technologies.map(skill => <li><span class="skill-marker" aria-hidden="true"></span><span>{skill}</span></li>)}</ul>
			</section>
			<section class="capability-group" aria-labelledby="industries-title">
				<h3 id="industries-title" class="capability-label" data-i18n="home.industriesLabel">{en.home.industriesLabel}</h3>
				<ul class="skills-list">{profile.industries.map(skill => <li><span class="skill-marker" aria-hidden="true"></span><span>{skill}</span></li>)}</ul>
			</section>
		</div>
	</section>

	<section class="content-section" id="work" aria-labelledby="work-title">
		<div class="section-heading">
			<p class="section-label" data-i18n="home.workLabel">{en.home.workLabel}</p>
			<div>
				<h2 class="section-title" id="work-title" data-i18n="home.workTitle">{en.home.workTitle}</h2>
				<p class="section-copy" data-i18n="home.workIntro">{en.home.workIntro}</p>
			</div>
		</div>

<div class="projects-grid">
 {projects.map((project, index) => {
 const copy = en.home.projects[index];
 return <article class="project-card" aria-labelledby={`project-${project.id}`}>
 <div class="project-copy">
 <div class="project-topline"><span class="project-number">{project.number}</span><span class="project-status" data-i18n={`home.projects.${index}.status`}>{copy.status}</span></div>
 <h3 id={`project-${project.id}`} data-i18n={`home.projects.${index}.title`}>{copy.title}</h3>
 <p data-i18n={`home.projects.${index}.body`}>{copy.body}</p>
 <ul class="project-features" data-i18n-list={`home.projects.${index}.features`}>{copy.features.map(feature => <li data-list-item>{feature}</li>)}</ul>
 <p class="project-meta" data-i18n={`home.projects.${index}.meta`}>{copy.meta}</p>
 {project.video && <a class="project-link" href={project.video} target="_blank" rel="noopener noreferrer">
 <span data-i18n={`home.projects.${index}.cta`}>{copy.cta}</span>
 <svg class="project-link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg>
 </a>}
 </div>
 <div class="project-media"><ProjectGallery project={project} index={index} />
 </div></article>;
 })}
 </div>
	</section>

	<section class="content-section home-support-callout" aria-labelledby="support-title">
		<div class="section-heading">
			<p class="section-label" data-i18n="home.supportLabel">{en.home.supportLabel}</p>
			<div>
				<h2 class="section-title" id="support-title" data-i18n="home.supportTitle">{en.home.supportTitle}</h2>
				<p class="section-copy" data-i18n="home.supportBody">{en.home.supportBody}</p>
				<a class="button-link" href="/support/" data-i18n="home.supportCta">{en.home.supportCta}</a>
			</div>
		</div>
	</section>
</BaseLayout>
