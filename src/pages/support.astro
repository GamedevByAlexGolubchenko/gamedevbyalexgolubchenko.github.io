---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailContact from '../components/EmailContact.astro';
import { profile, translations } from '../data/site';
import '../styles/support.css';

const en = translations.en;
---

<BaseLayout page="support" title={en.meta.supportTitle} description={en.meta.supportDescription}>
	<section class="support-hero" aria-labelledby="support-title">
		<div class="support-hero-main">
			<p class="eyebrow" data-i18n="support.eyebrow">{en.support.eyebrow}</p>
			<h1 id="support-title" data-i18n="support.title">{en.support.title}</h1>
			<p class="hero-intro" data-i18n="support.intro">{en.support.intro}</p>
		</div>
		<aside class="support-aside" aria-labelledby="support-contact-title">
			<h2 class="section-label" id="support-contact-title" data-i18n="support.availabilityLabel">{en.support.availabilityLabel}</h2>
			<p data-i18n="support.availabilityBody">{en.support.availabilityBody}</p>
			<EmailContact email={profile.supportEmail} label={en.support.emailCta} labelKey="support.emailCta" />
		</aside>
	</section>

	<section class="content-section support-section" aria-labelledby="process-title">
		<div class="section-heading">
			<p class="section-label" data-i18n="support.processLabel">{en.support.processLabel}</p>
			<div class="support-section-body">
			<h2 class="section-title" id="process-title" data-i18n="support.processTitle">{en.support.processTitle}</h2>
		<div class="process-grid">
			<article class="process-item">
				<h3 data-i18n="support.stepOneTitle">{en.support.stepOneTitle}</h3>
				<p data-i18n="support.stepOneBody">{en.support.stepOneBody}</p>
			</article>
			<article class="process-item">
				<h3 data-i18n="support.stepTwoTitle">{en.support.stepTwoTitle}</h3>
				<p data-i18n="support.stepTwoBody">{en.support.stepTwoBody}</p>
			</article>
			<article class="process-item">
				<h3 data-i18n="support.stepThreeTitle">{en.support.stepThreeTitle}</h3>
				<p data-i18n="support.stepThreeBody">{en.support.stepThreeBody}</p>
			</article>
		</div>
			</div>
		</div>
	</section>

	<section class="content-section support-section" aria-labelledby="scope-title">
		<div class="section-heading">
			<p class="section-label" data-i18n="support.scopeLabel">{en.support.scopeLabel}</p>
			<div class="support-section-body">
				<h2 class="section-title" id="scope-title" data-i18n="support.scopeTitle">{en.support.scopeTitle}</h2>
				<ul class="skills-list support-scope">
					{en.support.scopeItems.map((item, index) => <li><span class="skill-marker" aria-hidden="true"></span><span data-i18n={`support.scopeItems.${index}`}>{item}</span></li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="content-section support-section support-contact" aria-labelledby="contact-title">
		<div class="section-heading">
			<p class="section-label" data-i18n="support.contactLabel">{en.support.contactLabel}</p>
			<div class="support-section-body">
				<h2 class="section-title" id="contact-title" data-i18n="support.contactTitle">{en.support.contactTitle}</h2>
				<p class="section-copy" data-i18n="support.contactBody">{en.support.contactBody}</p>
				<EmailContact email={profile.contactEmail} label={en.support.contactCta} labelKey="support.contactCta" layout="compact" />
			</div>
		</div>
	</section>
</BaseLayout>
