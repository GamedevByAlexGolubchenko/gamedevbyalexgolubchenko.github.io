---
import { localeFromPath, pagePath } from '../data/routing';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { translations, locales, type PageName } from '../data/site';
import '../styles/global.css';
import '../styles/theme.css';

interface Props {
	page: PageName;
	title: string;
	description: string;
}

const { page, title, description } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale} data-design="engine">
	<head>
		<meta charset="UTF-8" />
		{import.meta.env.PROD && (
			<>
				<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4VE01XSTT8"></script>
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', 'G-4VE01XSTT8');
				</script>
			</>
		)}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0B1020" />
		<meta name="description" content={description} data-i18n-content={`meta.${page}Description`} />
		<link rel="canonical" href={canonicalURL} />
        {locales.map(language => <link rel="alternate" hreflang={language.code} href={new URL(pagePath(language.code, page), Astro.site)} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(pagePath('en', page), Astro.site)} />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<link rel="preload" href="/fonts/inter/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} data-i18n-content={`meta.${page}Title`} />
		<meta property="og:description" content={description} data-i18n-content={`meta.${page}Description`} />
		<meta property="og:site_name" content={translations[locale].common.name} data-i18n-content="common.name" />
		<meta name="twitter:card" content="summary" />
		<title data-i18n={`meta.${page}Title`}>{title}</title>
	</head>
	<body data-page={page}>
		<div class="page-shell">
			<SiteHeader page={page} />
			<main id="main"><slot /></main>
			<SiteFooter />
		</div>

		<script id="i18n-data" type="application/json" set:html={JSON.stringify(translations)}></script>

		<script>
			import '../scripts/translation-layout';

			const workSection = document.querySelector('#work');
			const syncNavigation = () => {
				const page = document.body.dataset.page;
				const reachedWork = workSection && workSection.getBoundingClientRect().top <= window.innerHeight * 0.25;
				const current = page === 'home' && reachedWork ? 'work' : page;

				document.querySelectorAll('[data-nav]').forEach((link) => {
					const isCurrent = link.dataset.nav === current;
					link.classList.toggle('active', isCurrent);
					if (isCurrent) {
						link.setAttribute('aria-current', current === 'work' ? 'location' : 'page');
					} else {
						link.removeAttribute('aria-current');
					}
				});
			};

			syncNavigation();
			let navigationFrame = 0;
			const scheduleNavigationSync = () => {
				if (navigationFrame) return;
				navigationFrame = window.requestAnimationFrame(() => {
					navigationFrame = 0;
					syncNavigation();
				});
			};
			if (workSection) {
				window.addEventListener('scroll', scheduleNavigationSync, { passive: true });
				window.addEventListener('resize', scheduleNavigationSync);
				window.addEventListener('hashchange', scheduleNavigationSync);
				window.addEventListener('pageshow', scheduleNavigationSync);
				new ResizeObserver(scheduleNavigationSync).observe(document.querySelector('main'));
			}

			const languagePicker = document.querySelector('[data-language-picker]');
			const closeLanguagePicker = (restoreFocus = false) => {
				if (!languagePicker?.open) return;
				languagePicker.open = false;
				if (restoreFocus) languagePicker.querySelector('summary').focus();
			};
			document.addEventListener('click', event => {
				if (!languagePicker?.contains(event.target)) closeLanguagePicker();
			});
			document.addEventListener('keydown', event => {
				if (event.key === 'Escape') closeLanguagePicker(true);
			});
			// Safari may blur the trigger without focusing a tapped option.
			// Wait for actual outside focus so the option can receive its click.
			document.addEventListener('focusin', event => {
				if (!languagePicker?.contains(event.target)) closeLanguagePicker();
			});
		</script>
	</body>
</html>
