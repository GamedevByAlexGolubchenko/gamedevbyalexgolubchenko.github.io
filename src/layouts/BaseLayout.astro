---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { translations, careerStart, type PageName } from '../data/site';
import '../styles/global.css';
import '../styles/theme.css';

interface Props {
	page: PageName;
	title: string;
	description: string;
}

const { page, title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-design="engine">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(() => {
				let locale = 'en';
				try { locale = localStorage.getItem('alex-site-locale') === 'ru' ? 'ru' : 'en'; } catch {}
				document.documentElement.lang = locale;
				if (locale === 'ru') {
					document.documentElement.setAttribute('data-locale-pending', '');
					// Keep the page usable if localization unexpectedly fails.
					window.setTimeout(() => document.documentElement.removeAttribute('data-locale-pending'), 1500);
				}
			})();
		</script>
		<style is:global>
			html[data-locale-pending] body { visibility: hidden; }
		</style>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0B1020" />
		<meta name="description" content={description} data-i18n-content={`meta.${page}Description`} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="preload" href="/fonts/inter/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} data-i18n-content={`meta.${page}Title`} />
		<meta property="og:description" content={description} data-i18n-content={`meta.${page}Description`} />
		<meta property="og:site_name" content={translations.en.common.name} data-i18n-content="common.name" />
		<meta name="twitter:card" content="summary" />
		<title data-i18n={`meta.${page}Title`}>{title}</title>
	</head>
	<body data-page={page}>
		<div class="page-shell">
			<SiteHeader page={page} />
			<main id="main"><slot /></main>
			<SiteFooter />
		</div>

		<script id="i18n-data" type="application/json" set:html={JSON.stringify(translations)}></script>
		<script id="career-start" type="application/json" set:html={JSON.stringify(careerStart)}></script>
		<script is:inline>
			const storageKey = 'alex-site-locale';
			const dataNode = document.querySelector('#i18n-data');
			const dictionaries = dataNode ? JSON.parse(dataNode.textContent || '{}') : {};
			const careerStart = JSON.parse(document.querySelector('#career-start').textContent);
			const getValue = (source, path) => {
				const value = path.split('.').reduce((value, key) => value?.[key], source);
				if (typeof value !== 'string' || !value.includes('{experienceYears}')) return value;
				const now = new Date();
				const years = Math.max(0, now.getFullYear() - careerStart.year - (now.getMonth() + 1 < careerStart.month ? 1 : 0));
				const locale = document.documentElement.lang;
				const category = new Intl.PluralRules(locale).select(years);
				const unit = locale === 'ru' ? (category === 'one' ? 'года' : 'лет') : (category === 'one' ? 'year' : 'years');
				return value.replaceAll('{experienceYears}', String(years)).replaceAll('{experienceUnit}', unit);
			};

			const applyLocale = (locale, scope = document) => {
				const dictionary = dictionaries[locale] || dictionaries.en;
				document.documentElement.lang = locale;

				scope.querySelectorAll('[data-i18n-aria]').forEach((element) => {
					const value = getValue(dictionary, element.dataset.i18nAria);
					if (typeof value === 'string') element.setAttribute('aria-label', value);
				});

				scope.querySelectorAll('[data-i18n]').forEach((element) => {
					const value = getValue(dictionary, element.dataset.i18n);
					if (typeof value === 'string') element.textContent = value;
				});

				scope.querySelectorAll('[data-i18n-content]').forEach((element) => {
					const value = getValue(dictionary, element.dataset.i18nContent);
					if (typeof value === 'string') element.setAttribute('content', value);
				});

				scope.querySelectorAll('[data-i18n-alt]').forEach((element) => {
					const value = getValue(dictionary, element.dataset.i18nAlt);
					if (typeof value === 'string') element.setAttribute('alt', value);
				});

				scope.querySelectorAll('[data-i18n-list]').forEach((list) => {
					const values = getValue(dictionary, list.dataset.i18nList);
					if (!Array.isArray(values)) return;
					list.querySelectorAll('[data-list-item]').forEach((item, index) => {
						if (typeof values[index] === 'string') item.textContent = values[index];
					});
				});

				scope.querySelectorAll('[data-locale-option]').forEach((option) => {
					option.classList.toggle('active', option.dataset.localeOption === locale);
				});

				const toggle = scope.querySelector('[data-language-toggle]');
				if (toggle) {
					toggle.setAttribute('aria-label', dictionary.nav.language);
					toggle.dataset.locale = locale;
				}

				const page = document.body.dataset.page;
				const localizedTitle = getValue(dictionary, `meta.${page}Title`);
				if (scope === document && typeof localizedTitle === 'string') document.title = localizedTitle;
			};

			const initialLocale = document.documentElement.lang === 'ru' ? 'ru' : 'en';
			// Measure both translations off screen. Text gets room to wrap without
			// moving the artwork, cards, or following sections when the locale changes.
			const stableSelector = 'h1[data-i18n], h2[data-i18n], h3[data-i18n], p[data-i18n], .project-features li, .skills-list li, .hero-stack-description, .capability-label, .button-link, .project-link, .primary-nav a';
			const reserveTranslationSpace = () => {
				const shell = document.querySelector('.page-shell');
				const locale = document.documentElement.lang;
				const targets = [...shell.querySelectorAll(stableSelector)];
				const probe = shell.cloneNode(true);
				probe.setAttribute('aria-hidden', 'true');
				probe.inert = true;
				probe.classList.add('translation-measure');
				probe.style.width = `${shell.getBoundingClientRect().width}px`;
				const samples = [...probe.querySelectorAll(stableSelector)];
				samples.forEach(element => {
					element.style.removeProperty('min-height');
					element.style.removeProperty('min-width');
				});
				document.body.append(probe);
				const heights = targets.map(() => 0);
				const widths = targets.map(() => 0);
				try {
					for (const language of Object.keys(dictionaries)) {
						applyLocale(language, probe);
						samples.forEach((element, index) => {
							const rect = element.getBoundingClientRect();
							heights[index] = Math.max(heights[index], rect.height);
							if (element.matches('.primary-nav a, .action-row .button-link')) widths[index] = Math.max(widths[index], rect.width);
						});
					}
				} finally {
					probe.remove();
					document.documentElement.lang = locale;
				}
				targets.forEach((element, index) => {
					if (heights[index]) element.style.minHeight = `${Math.ceil(heights[index])}px`;
					if (widths[index]) element.style.minWidth = `${Math.ceil(widths[index])}px`;
				});
			};
			reserveTranslationSpace();
			applyLocale(initialLocale);
			document.documentElement.removeAttribute('data-locale-pending');
			let translationFrame;
			let translationWidth = document.documentElement.clientWidth;
			window.addEventListener('resize', () => {
				const width = document.documentElement.clientWidth;
				if (width === translationWidth) return;
				translationWidth = width;
				cancelAnimationFrame(translationFrame);
				translationFrame = requestAnimationFrame(reserveTranslationSpace);
			}, { passive: true });
			document.fonts.ready.then(reserveTranslationSpace);

			const workSection = document.querySelector('#work');
			const syncNavigation = () => {
				const page = document.body.dataset.page;
				const reachedWork = workSection && workSection.getBoundingClientRect().top <= window.innerHeight * 0.25;
				const current = page === 'home' && reachedWork ? 'work' : page;

				document.querySelectorAll('[data-nav]').forEach((link) => {
					const isCurrent = link.dataset.nav === current;
					link.classList.toggle('active', isCurrent);
					if (isCurrent) {
						link.setAttribute('aria-current', current === 'work' ? 'location' : 'page');
					} else {
						link.removeAttribute('aria-current');
					}
				});
			};

			syncNavigation();
			let navigationFrame = 0;
			const scheduleNavigationSync = () => {
				if (navigationFrame) return;
				navigationFrame = window.requestAnimationFrame(() => {
					navigationFrame = 0;
					syncNavigation();
				});
			};
			if (workSection) {
				window.addEventListener('scroll', scheduleNavigationSync, { passive: true });
				window.addEventListener('resize', scheduleNavigationSync);
				window.addEventListener('hashchange', scheduleNavigationSync);
				window.addEventListener('pageshow', scheduleNavigationSync);
				new ResizeObserver(scheduleNavigationSync).observe(document.querySelector('main'));
			}

			document.querySelector('[data-language-toggle]')?.addEventListener('click', (event) => {
				const button = event.currentTarget;
				const nextLocale = button.dataset.locale === 'en' ? 'ru' : 'en';
				applyLocale(nextLocale);
				try { localStorage.setItem(storageKey, nextLocale); } catch {}
			});
		</script>
	</body>
</html>
